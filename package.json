{
  "name": "riffreel",
  "version": "0.0.0",
  "description": "RiffReel — on-device guitar riff video maker (PWA)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "e2e": "playwright test --project=\"iPhone 15\" --project=\"Pixel 7\"",
    "golden": "playwright test --project=golden",
    "golden:update": "UPDATE_GOLDEN=1 playwright test --project=golden",
    "accuracy": "vitest run --config vitest.accuracy.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maknistong68/Riffs-Video.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/Maknistong68/Riffs-Video/issues"
  },
  "homepage": "https://github.com/Maknistong68/Riffs-Video#readme",
  "dependencies": {
    "@coderline/alphatab": "^1.8.4",
    "@fontsource/inter": "^5.3.0",
    "@mediabunny/aac-encoder": "^1.62.1",
    "@spotify/basic-pitch": "^1.0.1",
    "@tensorflow/tfjs": "^3.21.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "mediabunny": "^1.62.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "typescript": "~5.9",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module"
}
