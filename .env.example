# AI import (phase 4). Both values are PUBLIC by design (Supabase project URL + anon key);
# the Claude API key is NOT here — it is a secret of the Edge Function (see docs/AI_IMPORT.md).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Optional: full URL of the function instead of <VITE_SUPABASE_URL>/functions/v1/convert-tab
# VITE_CONVERT_TAB_URL=
